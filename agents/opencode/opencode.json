{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "theme": "system",
  "autoupdate": false,
  "plugin": [],
  "mcp": {
    "basic-memory": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp",
      "enabled": true
    },
    "codebase-memory-mcp": {
      "command": [
        "/home/parm/.local/bin/codebase-memory-mcp"
      ],
      "type": "local",
      "enabled": false
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": false
    },
    "neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": false
    }
  }
}
